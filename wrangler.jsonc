{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "post-like-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-20",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"ALLOWED_ORIGIN": "*"
	},
	"kv_namespaces": [
		{
			"binding": "LIKE_DB",
			"id": "9c4c88b742974feebc1a7ed6cfb1fb86",
			"remote": true
		}
	],
	"ratelimits": [
		{
			"name": "LIKE_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 }
		}
	]
}